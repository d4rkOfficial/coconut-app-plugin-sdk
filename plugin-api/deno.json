{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "strict": true,
    "noImplicitAny": false,
    "types": ["./coconut-plugin.d.ts", "./tools.d.ts"]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 4,
    "singleQuote": true,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars", "require-await", "no-empty"]
    }
  },
  "tasks": {
    "check": "deno check .",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "tools": "node generate-tools.mjs"
  }
}
