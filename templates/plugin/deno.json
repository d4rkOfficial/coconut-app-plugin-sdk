{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "deno.ns"],
        "strict": true,
        "noImplicitAny": false,
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment",
        "types": ["../../plugin-api/coconut-plugin.d.ts", "../../plugin-api/tools.d.ts"]
    },
    "imports": {
        "@std/path": "jsr:@std/path@^1.0.8"
    },
    "exclude": ["node_modules"],
    "fmt": {
        "lineWidth": 100,
        "indentWidth": 4,
        "singleQuote": true,
        "semiColons": false
    },
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "exclude": [
                "no-explicit-any",
                "no-unused-vars",
                "require-await",
                "no-empty",
                "jsx-key"
            ]
        }
    }
}
